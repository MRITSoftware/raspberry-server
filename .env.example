# Nome do site/unidade — usado para identificar este Pi no Supabase e filtrar comandos remotos.
# Use o mesmo nome que aparece no painel (ex: FILIAL_SP, LOJA_CENTRO, UNIDADE_01)
SITE_NAME=NOME_DA_UNIDADE

# Token de administração para endpoints protegidos (/config/tuya, /config/supabase)
ADMIN_TOKEN=troque_por_token_secreto

# Supabase (opcional — já vem preenchido no código, mas pode sobrescrever aqui)
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# Contas Tuya (opcional — já vem preenchido no código, mas pode sobrescrever aqui)
# TUYA_ACCOUNTS=[{"access_id":"...","access_key":"...","endpoint":"https://openapi.tuyaus.com","uid":"..."}]
